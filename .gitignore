# Unity project .gitignore for QuestArucoTracking (Quest 3 ArUco tracking)
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# ---- Unity generated folders (rebuilt automatically when the project opens) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Native build temp files (CMake/Gradle intermediates)
.utmp/
.gradle/

# Burst debug symbols written next to builds
*_BurstDebugInformation_DoNotShip/

# ---- IDE / solution files (Unity regenerates these) ----
.vs/
.vscode/
.idea/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Unity generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---- Build outputs ----
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Crash reports / misc generated files
sysinfo.txt
crashlytics-build.properties

# Addressables / streaming assets build data
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Old OpenCV for Unity plugin (no longer used; the OpenCV Android SDK in Assets/Plugins/Android is)
/[Aa]ssets/OpenCVForUnity/
/[Aa]ssets/OpenCVForUnity.meta

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini
